    f[426] = ["swatchling_combo", "Swatchling fight combo", "Volatile. The current combination of Swatchlings you are fighting. Later ones are harder, generally.", "-1=RRB, 0=ROB, 1=BGY, 2=ROY, 3=BYR, 4=RBY, 5=BYG, 6=RYB, 7=BRY, 8=YGO", 1];
    f[427] = ["unlocked_mint_chest", "Virovirokun Room: Unlocked the mint chest", "Whether Virovirokun triggered the hidden path to the Revive Mint chest.", "0/1", 1];
    f[428] = ["saw_sweet", "Sweet Cap'n Cakes: Saw Sweet", "Whether you saw Sweet right after the first teacup ride. Prevents him from appearing multiple times.", "0/1", 1];
    f[429] = ["statue_sink_progress", "Mansion 3f: Statue sink", "The amount by which the statue of Queen has sunk into the acid, in frames, so it persists even if you leave.", "", 1];
    f[430] = ["took_azzy_money", "Light World: Took Asriel's $5", "Whether you took five bucks from Asriel's drawer.", "0/1", 1];
    f[431] = ["talked_to_jigsaw_joe_ch2", "First Party Dojo Challenges: Talked to Jigsaw Joe", "Whether you talked to Jigsaw Joe yet in the Party Dojo, which he introduces.", "0/1", 1];
    f[432] = ["told_to_explore", "Castle Town: Told To Explore", "Whether Ralsei told you and Susie to explore the Castle Town yet.", "0/1", 1];
    f[433] = ["told_to_run_ch2", "Castle Town: Told to run", "Whether Susie reminded you that you can run in this game (if you fail to do so in the chapter).", "0/1", 1];
    f[434] = ["heard_spamton_deal_explanation", "Heard Spamton explain the deal", "Whether Spamton told you about our deal and the machine in the basement. Prevents him from skipping it if you buy KeyGen first.", "0/1", 1];
    f[435] = ["house_game_winner", "Mansion 3f: House Game Winner", "Who won Rouxls's house minigame.", "0=Default state, 1=Rouxls, 2=Kris, 3=Draw", 1];
    f[436] = ["called_mom_busy", "Called home during the ending", "Whether you called home during the Chapter 2 end sequence. Unique dialogue the first time, then everyone's too busy to pick it up.", "0/1", 1];
    f[437] = ["festival_companion_response", "Ending: Fave Party Member 2", "Who you told Susie you would take to the festival in the Chapter 2 end cutscene. Unaccessed.", "0=Default state, 1=Noelle, 2=Ralsei, 3=Susie, 4=...", 1];
    f[438] = ["tutorial_virovirokun_location", "Tutor Viro Location", "Where you fought the tutorial Virovirokun. Persists its ice statue in Snowgrave.", "0=Default state, 1=Progressed, 2=Backtracked", 1];
    f[439] = ["deposited_egg_ch2", "Sans's Store: Deposited the egg", "Whether you put the egg in the egg basket in Sans's store.", "0/1", 1];
    f[440] = ["interacted_with_ferris_poster", "Cyber City: Checked the Ferris wheel poster", "Whether you interacted with the Ferris wheel poster with Noelle. One-time event.", "0/1", 1];
    f[441] = ["talked_to_dating_shoes_addison", "Cyber City: Talked to the Dating Shoes Addison", "Whether you talked to the Addison selling Dating Shoes. One-time event. See also flag 421.", "0/1", 1];
    f[442] = ["learned_teacups", "Teacup Ride: Learned the teacup controls", "Whether you've taken your first teacup ride and possibly gotten a tutorial on operating it.", "0/1", 0];
    f[443] = ["told_save_town", "Castle Town Return: Heard Ralsei explain saving", "Whether Ralsei told you to feel free to SAVE and take a break in Castle Town.", "0/1", 1];
    f[444] = ["told_visit_town", "Light World: Heard Susie suggest Castle Town", "Whether Susie told you to go back and check out Castle Town, if you went down south first.", "0/1", 1];
    f[445] = ["read_cleaning_poster", "Cyber City: Read the cleaning poster", "Whether you interacted with the poster for Queen Cleaning Agent with Noelle behind you. Interesting dialogue exclusive to non-Snowgrave.", "0/1", 1];
    f[446] = ["went_weird_door", "Cyber City: Went Weird Door", "Whether you brought Noelle all the way back to the gray door. Unique dialogue about its creepiness, but not required for Snowgrave.", "0/1", 1];
    f[447] = ["broke_balloon_cheese", "Amusement Park: Broke Balloon Cheese", "Whether the balloon cheese, found right before the mice basket puzzle, was dropped.", "0/1", 1];
    f[448] = ["finished_big_forcefield", "Amusement Park: Finished Big Forcefield", "Whether you finished and disabled the right-side forcefields in that room where Noelle stands on a button forever.", "0/1", 1];
    f[449] = ["easter_egg_forcefield", "Amusement Park: Triggered the forcefield easter egg", "Whether you disabled the Easter egg forcefield (with the balloons) by all getting in one teacup.", "0/1", 1];
    f[450] = ["balloon_teacup_easter_egg_progress", "Amusement Park: Teacup easter egg", "Progress in the balloon-teacup Easter egg.", "0=Default state, 1=Read sign, 2=Rode teacups", 1];
    f[451] = ["talked_to_sans_about_papyrus", "Sans's Store: Talked to Sans about Papyrus", "Whether you talked to Sans about Papyrus in both chapters 1 and 2; talking in Chapter 2 only isn't saved.", "0/1", 1];
    f[452] = ["told_wrongway", "Trash Zone: Told Wrongway", "Whether Noelle questioned if you were going the right way while backtracking further into the trash zone.", "0/1", 1];
    f[453] = ["talked_to_spamton_behind_basement_door", "Talked to Spamton behind the basement door", "Whether you talked to Spamton through the basement door while he was changing forms. He doesn't repeat himself.", "0/1", 1];
    f[454] = ["obtained_dealmaker", "Spamton: Got Dealmaker", "Whether you spared Spamton NEO.", "0/1", 1];
    f[455] = ["ride_with_me", "Weird Route: Ride With Me", "Whether you said 'Noelle will ride with me' on Snowgrave.", "0/1", 1];
    f[456] = ["defeated_snowgrave_neo", "Weird Route: Defeated SnowGrave NEO", "Whether you defeated Spamton NEO on Snowgrave.", "0/1", 1];
    f[457] = ["spared_berdly_all_three_times", "Berdly's Fights: Spared all three", "Whether you spared Berdly all three times, keeping him from breaking his arm.", "0/1", 1];
    f[458] = ["houses_hit", "Rouxls & Queen: Houses hit", "The number of houses you hit with the swan boat, converted to TP at the start of the Rouxls fight. Maximum 7.", "", 1];
    f[459] = ["put_disk_mannequin", "Spamton: Put the disk in the mannequin", "Whether you tried to put the LoadedDisk into the Mannequin. It doesn't repeat.", "0/1", 1];
    f[460] = ["obtained_jevil_hole", "Seam & King: Got the Jevil-hole item", "Whether you got the Jevil item from the Castle Town hole. Accessed, but not necessary.", "0/1", 1];
    f[461] = ["interacted_with_sink_ch2", "Hospital: Used the sink", "Whether you interacted with Rudy's sink in Chapter 2. See also flag 278.", "0/1", 1];
    f[462] = ["cars_hit", "Traffic: Cars hit", "The number of cars you hit. If less than 3 and you're otherwise pacifistic enough, you get the Castle Town tiny car.", "", 1];
    f[463] = ["read_cyberpedia", "Cyber Field: Read the Cyberpedia", "Whether you read Ralsei's editable Cyberpedia entry.", "0/1", 1];
    f[464] = ["talked_to_swatch_about_topchef", "Castle Town Return: Talked to Swatch about Topchef", "Whether you talked to Swatch in the Castle Town Cafe about removing Topchef. Poor man.", "0/1", 1];
    f[465] = ["car_part_completed", "Traffic: Completed the car section", "Whether you completed the car sequence. You can't get the tiny car on Snowgrave, even with all recruits, because of this.", "0/1", 1];
    f[466] = ["junkball_dropped", "Light World: Dropped the junk ball", "Whether you dropped the Ball of Junk at any point. Unaccessed.", "0/1", 1];
    f[467] = ["chestmark_opened", "Hacker's Checks Quest: Opened Chestmark", "Keeps you from opening the Chestmark chest multiple times.", "0/1", 1];
    f[468] = ["spamton_no_room", "Spamton No Room", "Whether you had no room after defeating Spamton NEO. Spawns the chest.", "0=Default state, 1=No room Pacifist, 2=No room Snowgrave", 1];
    f[469] = ["cant_go_back_tip", "Castle Town Return: Saw the no-return tip", "Whether the save point reminded you that you can't go back to the Cyber World if you overwrite your save in Castle Town. Consider this carefully!", "0/1", 1];
    f[500] = ["rudinn_fight_count", "First Rudinn fight count", "The number of times you've fought the first Rudinn. Changes its encounter text.", "", 1];
    f[501] = ["triple_hathy_outcome", "Triple Hathy encounter state", "Tracks an unused room_field2 encounter state and related dialogue.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[502] = ["ponman_fight_count", "Ponman fight count", "The number of times you fought Ponmen. Minor changes to the overworld chasing Ponmen.", "", 1];
    f[503] = ["susie_compliment_count", "Susie complimented Rudinn Ranger", "Whether Susie has attempted to compliment Rudinn Ranger. Free ham sandwich day does not repeat.", "0/1", 1];
    f[504] = ["susie_flirt_count", "Susie flirt attempts on Head Hathy", "The number of times you used X-Flirt on Head Hathy. She tries the first time, makes Ralsei try the second, and you take over from the third.", "", 1];
    f[505] = ["fought_rabbick", "Fought Rabbick", "Whether you fought any Rabbicks. If so, they run slower in the forest maze. Also set when you fight Clover.", "0/1", 1];
    f[506] = ["fought_bloxer", "Fought Bloxer", "Whether you fought Bloxer. If so, they don't chase you as diligently.", "0/1", 1];
    f[507] = ["fought_rudinn_ranger", "Fought Rudinn Ranger", "Whether you fought Rudinn Ranger. If so, they don't chase you at all.", "0/1", 1];
    f[508] = ["fought_hathyx", "Fought Head Hathy", "Whether you fought Head Hathy. If so, they don't chase you at all.", "0/1", 1];
    f[509] = ["pippins_bribe_act_count", "Pippins Ralsei ACT", "Number of Bribe ACTs used on Pippins. Unique dialogue first time.", "", 1];
    f[510] = ["pippins_cheat_act_count", "Pippins Susie ACT", "Number of Cheat ACTs used on Pippins.", "", 1];
    f[511] = ["used_s_action_on_shuttah", "Used Susie's ACT on Shuttah", "Whether you've used S-Action during a Shuttah battle. Randomizes flavortext on repeat.", "0/1", 1];
    f[512] = ["used_r_action_on_shuttah", "Used Ralsei's ACT on Shuttah", "Whether you've used R-Action during a Shuttah battle. Reduces flavortext on repeat.", "0/1", 1];
    f[513] = ["shuttah_kris_pic", "Shuttah Kris photo", "Whether you took a photo of Kris during the Shuttah fight. Alters repeat dialogue.", "0/1", 1];
    f[514] = ["shuttah_susie_pic", "Shuttah Susie photo", "Whether you took a photo of Susie during the Shuttah fight. Alters repeat dialogue.", "0/1", 1];
    f[515] = ["shuttah_ralsei_pic", "Shuttah Ralsei photo", "Whether you took a photo of Ralsei during the Shuttah fight. Alters repeat dialogue.", "0/1", 1];
    f[520] = ["rudinn_violences", "Rudinns beaten up", "The number of Rudinns you have beat up. Subtracted from flag 40 if you apologize.", "", 1];
    f[521] = ["hathy_violences", "Hathys beaten up", "The number of Hathys you have beat up. Subtracted from flag 40 if 2 or less and you apologize.", "", 1];
    f[522] = ["clover_violence", "Clover: Violence", "Whether you beat up Clover the first time. You can't apologize.", "0/1", 1];
    f[523] = ["rudinn_hit_by_susie_count", "Susie Rudinn whacks", "Intended for Susie beating up Rudinns, but unset. See flag 43.", "", 1];
    f[524] = ["hathy_hit_by_susie_count", "Susie Hathy whacks", "Intended for Susie beating up Hathys, but unset. See flag 43.", "", 1];
    f[525] = ["first_werewire_encounter_outcome", "Werewire", "Tracks the state of the first random Werewire encounter.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[526] = ["first_tasque_encounter_outcome", "Tasque", "Tracks the state of the first random Tasque encounter, the one that jumps out at you. Then it's reused for like Giga Queen deaths or something, which is a little broken.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[527] = ["first_virovirokun_encounter_outcome", "Virovirokun", "Tracks the state of the first Virovirokun encounter, the one en route to AGREE2ALL. Also reused for Giga Queen stuff, doing Round 1 hitless causes this to be set to 1.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[528] = ["second_smorgasbord_encounter_outcome", "Smorgasbord", "Tracks the state of the Smorgasboard 2 encounter.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[529] = ["berdly_1_encounter_outcome", "Berdly's Fights: First fight", "Tracks the state of the first Berdly battle. Used to determine if he breaks his arm.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[530] = ["first_poppup_encounter_outcome", "Poppup", "Tracks the state of the first Poppup encounter, before you meet Noelle.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[531] = ["tutorial_virovirokun_encounter_outcome", "Virovirokun", "Tracks the state of the Virovirokun that tells Noelle how to battle.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[532] = ["ambyu_lance_encounter_outcome", "Ambyu-Lance", "Tracks the state of the first Ambyu-Lance encounter.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[533] = ["antivirus_virovirokun_encounter_outcome", "Ambyu-Lance + Virovirokun", "Tracks the state of the Ambyu-Lance + Virovirokun encounter.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[534] = ["double_werewire_encounter_outcome", "2 Werewires", "Tracks the state of the double Werewire encounter toward the middle of Cyber City.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[535] = ["eraser_virovirokun_encounter_outcome", "2 Virovirokuns", "Tracks the state of the double Virovirokun encounter blocking the way to the Bounce Blade.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[536] = ["single_maus_encounter_outcome", "Maus", "Tracks the state of the single Maus encounter when rubbing the cheese.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
