    f[539] = ["glow_wrist_tasque_encounter_outcome", "Tasque", "Tracks the state of the second random Tasque encounter, in the room with the Glow Wrist and checksmark.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
