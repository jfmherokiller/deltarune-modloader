    f[557] = ["dining_hall_pipis_encounter_outcome", "Pipis encounter", "Tracks the state of the last Pipis encounter you had in the dining hall. Well, it would. Pipis don't chase you.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[558] = ["returning_tasque_encounter_outcome", "Tasques + Swatchlings", "Tracks the state of the Tasques and Swatchlings found when backtracking to Tasque Manager's room.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[559] = ["trash_zone_poppup_encounter_outcome", "Poppups", "Tracks the state of the Poppups found when backtracking to the Trash Zone with Noelle.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[560] = ["trash_zone_virovirokun_encounter_outcome", "Virovirokun", "Tracks the state of the Virovirokun found when backtracking to the Trash Zone on Snowgrave.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[561] = ["trash_zone_werewire_encounter_outcome", "Werewire", "Tracks the state of the Werewire found when backtracking to the Trash Zone on Snowgrave.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[562] = ["road_ambyu_lance_encounter_outcome", "Ambyu-Lance", "Tracks the state of the Ambyu-Lance found in the middle of the road on Snowgrave.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[563] = ["road_tasque_encounter_outcome", "Tasque", "Tracks the state of the Tasque found in the middle of the road on Snowgrave.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[564] = ["road_virovirokun_encounter_outcome", "Virovirokun", "Tracks the state of the Virovirokun found in the middle of the road on Snowgrave.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[565] = ["road_werewire_encounter_outcome", "Werewire", "Tracks the state of the Werewire found in the middle of the road on Snowgrave.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[566] = ["snowgrave_maice_2_encounter_outcome", "Maice", "Tracks the state of the second Maice encounter on Snowgrave.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[567] = ["snowgrave_double_poppup_encounter_outcome", "2 Poppups", "Tracks the state of the double Poppup encounter that hides under a cone on Snowgrave.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[569] = ["snowgrave_werewerewire_encounter_outcome", "Werewerewire", "That's gotta be the most abbreviated one yet! Tracks the state of Werewerewire on Snowgrave, since it's found elsewhere.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[570] = ["ultimate_heal_ambyu_lance_encounter_outcome", "Ambyu-Lance", "Tracks the state of the Ambyu-Lance encounter where Susie demonstrates UltimateHeal.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[571] = ["spamton_neo_encounter_outcome", "Spamton NEO", "Tracks how the Spamton NEO fight ended. The SnowGrave route sets this to Spared, the same value as a peaceful win, because the fight does not end by depleting his HP. A value of Violenced also makes the Spamton chest give the PuppetScarf weapon instead of the DealMaker armor.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[572] = ["vase_poppup_encounter_outcome", "Poppup", "Tracks the state of the Poppup under the vase near where Susie and Ralsei leave you.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[580] = ["board_1_oasis_shadowguy_encounter_outcome", "2 Shadowguys", "Tracks the state of the Shadowguy encounter in the room on the left of the oasis in Board 1.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[581] = ["board_1_block_room_shadowguy_encounter_outcome", "3 Shadowguys", "Tracks the state of the Shadowguy encounter in the block-pushing room in Board 1.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[582] = ["board_2_shrine_pippins_encounter_outcome", "2 Pippins", "Tracks the state of the Pippins encounter in the room on the left of the Kodakoda shrine in Board 2.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[583] = ["board_2_controller_pippins_encounter_outcome", "3 Pippins", "Tracks the state of the Pippins encounter that Susie runs into using Kris's controller in Board 2.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[584] = ["board_2_shuttah_encounter_outcome", "Shuttah", "Tracks the state of the Shuttah boss battle in Board 2.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[585] = ["rouxls_weather_encounter_outcome", "Rouxls & Tenna: Rouxls + Weather Duo", "Tracks the state of the Rouxls Kaard throuple battle.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
