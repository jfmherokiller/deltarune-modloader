// CheatMenu page: Enemies (battle only). The 3 enemy slots live in global.monster* arrays.
// Page interface: see obj_drcheat Create. drc_in_battle() is shared (obj_drcheat Create).
function scr_drcheat_page_enemies(_mode)
{
    switch (_mode)
    {
        case "init":
            if (!variable_global_exists("drcheat_automercy"))
            {
                global.drcheat_automercy = 0;
                global.drcheat_ensel = 0;
            }
            // enemies the game never lets you spare (per chapter, generated by tools/gen_nospare.csx from the
            // game's own code: SPARE event is a no-op, mercy forced back to 0, or no way to gain mercy).
            // Forcing their spare state breaks the scripted fight (crash seen sparing Ch2 Queen).
            drc_nospare_types = scr_drcheat_nospare();
            drc_en_nospare = function(_i)
            {
                var _t = global.monstertype[_i];
                for (var _k = 0; _k < array_length(drc_nospare_types); _k++)
                {
                    if (drc_nospare_types[_k] == _t)
                        return 1;
                }
                return 0;
            };
            drc_en_alive = function(_i)
            {
                return global.monster[_i] == 1;
            };
            drc_en_mercymax = function(_i)
            {
                var _m = 100;
                if (variable_global_exists("mercymax") && is_real(global.mercymax[_i]))
                    _m = max(100, global.mercymax[_i]);
                return _m;
            };
            // the battle's SPARE / Pacify checks mercy >= mercymax and status 1 (Tired)
            drc_en_spareable = function(_i)
            {
                global.mercymod[_i] = drc_en_mercymax(_i);
                global.monsterstatus[_i] = 1;
            };
            // rows: [kind, enemy]; 0 auto mercy, 1 all spareable, 2 all HP 1, 10 HP, 11 mercy, 12 tired
            drc_en_rows = function()
            {
                var _r = [[0, -1], [1, -1], [2, -1]];
                if (drc_in_battle())
                {
                    for (var _i = 0; _i < 3; _i++)
                    {
                        if (drc_en_alive(_i))
                        {
                            array_push(_r, [10, _i]);
                            if (!drc_en_nospare(_i))
                            {
                                array_push(_r, [11, _i]);
                                array_push(_r, [12, _i]);
                            }
                        }
                    }
                }
                return _r;
            };
            drc_en_name = function(_i)
            {
                var _n = "";
                if (variable_global_exists("monstername") && is_string(global.monstername[_i]))
                    _n = global.monstername[_i];
                if (_n == "")
                    _n = "Enemy " + string(_i + 1);
                return _n;
            };
            return { label: "Enemies...", why: "" };

        case "tick":
            if (global.drcheat_automercy && drc_in_battle())
            {
                for (var i = 0; i < 3; i++)
                {
                    if (drc_en_alive(i) && !drc_en_nospare(i) && global.mercymod[i] < drc_en_mercymax(i))
                        drc_en_spareable(i);
                }
            }
            break;

        case "step":
            var rows = drc_en_rows();
            var nr = array_length(rows);
            var r = clamp(global.drcheat_ensel, 0, nr - 1);
            var step = drc_step;
            var ok = drc_ok;
            if (keyboard_check_pressed(vk_up)) { r = (r + nr - 1) mod nr; snd_play(snd_menumove); }
            if (keyboard_check_pressed(vk_down)) { r = (r + 1) mod nr; snd_play(snd_menumove); }
            var kind = rows[r][0];
            var e = rows[r][1];
            var fight = drc_in_battle();
            switch (kind)
            {
                case 0:
                    if (ok || step != 0) { global.drcheat_automercy = !global.drcheat_automercy; snd_play(snd_select); }
                    break;
                case 1:
                    if (ok && fight)
                    {
                        var done = 0;
                        var skipped = 0;
                        for (var i = 0; i < 3; i++)
                        {
                            if (!drc_en_alive(i)) continue;
                            if (drc_en_nospare(i)) { skipped++; continue; }
                            drc_en_spareable(i);
                            done++;
                        }
                        if (done == 0 && skipped > 0) { drc_msg = "Can't be spared"; snd_play(snd_smallswing); }
                        else { drc_msg = (skipped > 0) ? "Spareable (some can't be)" : "All can be spared"; snd_play(snd_select); }
                        drc_msgtime = 60;
                    }
                    break;
                case 2:
                    if (ok && fight)
                    {
                        for (var i = 0; i < 3; i++)
                            if (drc_en_alive(i)) global.monsterhp[i] = 1;
                        drc_msg = "Enemy HP set to 1"; drc_msgtime = 60; snd_play(snd_select);
                    }
                    break;
                case 10:
                    if (step != 0)
                    {
                        global.monsterhp[e] = clamp(global.monsterhp[e] + step * (drc_big ? 100 : 10), 1, max(1, global.monstermaxhp[e]));
                        snd_play(snd_menumove);
                    }
                    break;
                case 11:
                    if (step != 0)
                    {
                        global.mercymod[e] = clamp(global.mercymod[e] + step * (drc_big ? 100 : 10), 0, drc_en_mercymax(e));
                        snd_play(snd_menumove);
                    }
                    break;
                case 12:
                    if (ok || step != 0)
                    {
                        global.monsterstatus[e] = (global.monsterstatus[e] == 1) ? 0 : 1;
                        snd_play(snd_select);
                    }
                    break;
            }
            global.drcheat_ensel = r;
            break;

        case "draw":
            var bx = drc_bx;
            var by = drc_by;
            var bh = drc_bh;
            draw_text(bx + 50, by + 12, "ENEMIES");
            var rows = drc_en_rows();
            var nr = array_length(rows);
            var r = global.drcheat_ensel;
            var rx = bx + 50;
            var vx = bx + 250;
            var ry = by + 48;
            var rh = 26;
            var fight = drc_in_battle();
            // layout first: an enemy's header line sits above its HP row
            var ys = [];      // row y, relative to the list top
            var tops = [];    // top of the row including its header
            var yy = 0;
            for (var i = 0; i < nr; i++)
            {
                tops[i] = yy;
                if (rows[i][0] == 10)
                    yy += 6 + rh;
                ys[i] = yy;
                yy += rh;
            }
            // scroll so the selected row (and its header) stays inside the box
            var avail = (by + bh - 40) - ry;
            var off = 0;
            if (r >= 0 && r < nr)
                off = clamp(ys[r] + rh - avail, 0, tops[r]);
            for (var i = 0; i < nr; i++)
            {
                var kind = rows[i][0];
                var e = rows[i][1];
                if (ys[i] < off || ys[i] + rh - off > avail)
                    continue;
                if (kind == 10 && tops[i] + 6 >= off)
                {
                    draw_set_color(c_aqua);
                    draw_text(rx - 10, ry + tops[i] + 6 - off, drc_en_name(e) + (drc_en_nospare(e) ? "  (can't be spared)" : ""));
                }
                var y0 = ry + ys[i] - off;
                var lab = "";
                var v = "";
                switch (kind)
                {
                    case 0: lab = "Auto mercy"; v = global.drcheat_automercy ? "ON" : "OFF"; break;
                    case 1: lab = "All: can spare"; break;
                    case 2: lab = "All: HP 1"; break;
                    case 10: lab = "HP"; v = "< " + string(global.monsterhp[e]) + " > / " + string(global.monstermaxhp[e]); break;
                    case 11: lab = "Mercy"; v = "< " + string(global.mercymod[e]) + "% >"; break;
                    case 12: lab = "Tired"; v = (global.monsterstatus[e] == 1) ? "YES" : "NO"; break;
                }
                var dim = (kind == 1 || kind == 2) && !fight;
                draw_set_color((i == r) ? c_yellow : (dim ? c_gray : c_white));
                draw_text(rx + ((kind >= 10) ? 16 : 0), y0, lab);
                draw_text(vx, y0, v);
                if (i == r)
                    draw_sprite(spr_heart, 0, rx - 26, y0 + 8);
            }
            drc_draw_more(ry, ry + avail - rh, off > 0, yy - off > avail);
            draw_set_color(c_gray);
            if (!fight)
                draw_text(rx, ry + yy + 10, "(not in a battle)");
            draw_set_color(c_gray);
            draw_text(bx + 20, by + bh - 34, "Z/</> change  SHIFT x10  X back");
            if (drc_msgtime > 0)
            {
                draw_set_color(c_lime);
                draw_text(vx, by + 12, drc_msg);
            }
            draw_set_color(c_white);
            break;
    }
    return undefined;
}
