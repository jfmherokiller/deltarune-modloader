    f[546] = ["rouxls_encounter_outcome", "Rouxls & Queen: Rouxls", "Tracks the state of the Rouxls/Thrash Machine battle.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[547] = ["werewerewire_encounter_outcome", "Werewerewire", "Tracks the state of the Werewerewire encounter.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[548] = ["queen_encounter_outcome", "Rouxls & Queen: Queen", "Tracks the state of the normal Queen battle. Used to determine if Berdly breaks his arm.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[549] = ["spamton_encounter_outcome", "Spamton", "Tracks the state of the normal Spamton battle.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[550] = ["berdly_2_encounter_outcome", "Berdly's Fights: Second fight", "Tracks the state of the second Berdly battle. Used to determine if he breaks his arm.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[551] = ["giga_queen_encounter_outcome", "GIGA Queen", "Tracks the state saved for the GIGA Queen battle.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[552] = ["scripted_encounter_outcome", "Scripted battles", "Tracks the state of various scripted encounters that are non-repeatable anyway (first Werewires and Sweet Cap'n Cakes).", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[553] = ["triple_ambyu_lance_encounter_outcome", "3 Ambyu-Lances", "Tracks the state of the triple Ambyu-Lance encounter on Snowgrave in the big car room.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[554] = ["tasque_virovirokun_encounter_outcome", "Tasque + 2 Virovirokuns", "Tracks the state of the double Virovirokun single Tasque encounter on Snowgrave.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[555] = ["snowgrave_maice_1_encounter_outcome", "Maice", "Tracks the state of the first Maice encounter on Snowgrave (no cheese is involved).", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[556] = ["fleeing_tasque_encounter_outcome", "Tasques", "Tracks the state of the Snowgrave Tasques that run away from you.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[557] = ["dining_hall_pipis_encounter_outcome", "Pipis encounter", "Tracks the state of the last Pipis encounter you had in the dining hall. Well, it would. Pipis don't chase you.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[558] = ["returning_tasque_encounter_outcome", "Tasques + Swatchlings", "Tracks the state of the Tasques and Swatchlings found when backtracking to Tasque Manager's room.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
