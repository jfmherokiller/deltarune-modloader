    f[900] = ["vessel_head", "Head", "The head of your vessel.", "0=Bald, 1=Frisk-like, 2=Left lock, 3=Middle part, 4=Thick hair, 5=Loose, 6=Balding line, 7=Refined", 1];
    f[901] = ["vessel_body", "Body", "The body of your vessel.", "0=Long sleeves, 1=Short sleeves, 2=Baggy sleeves, 3=Baggier sleeves, 4=Zipper, 5=Buttons", 1];
    f[902] = ["vessel_legs", "Legs", "The legs of your vessel.", "0=Wider on right, 1=Wider on right, 2=Wider on right, 3=Wider on right, 4=Wider on left", 1];
    f[903] = ["vessel_food", "What is its favorite food?", "Your vessel's favorite food.", "0=Sweet, 1=Soft, 2=Sour, 3=Salty, 4=Pain, 5=Cold", 1];
    f[904] = ["vessel_blood", "Your favorite blood type?", "Your favorite blood type.", "0=A, 1=AB, 2=B, 3=C, 4=D", 1];
    f[905] = ["vessel_color", "What color does it like most?", "Your vessel's favorite color.", "0=Red, 1=Blue, 2=Green, 3=Cyan", 1];
