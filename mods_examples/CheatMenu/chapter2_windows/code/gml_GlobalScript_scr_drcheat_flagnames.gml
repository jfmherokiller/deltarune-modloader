    f[565] = ["road_werewire_encounter_outcome", "Werewire", "Tracks the state of the Werewire found in the middle of the road on Snowgrave.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[566] = ["snowgrave_maice_2_encounter_outcome", "Maice", "Tracks the state of the second Maice encounter on Snowgrave.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[567] = ["snowgrave_double_poppup_encounter_outcome", "2 Poppups", "Tracks the state of the double Poppup encounter that hides under a cone on Snowgrave.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[569] = ["snowgrave_werewerewire_encounter_outcome", "Werewerewire", "That's gotta be the most abbreviated one yet! Tracks the state of Werewerewire on Snowgrave, since it's found elsewhere.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[570] = ["ultimate_heal_ambyu_lance_encounter_outcome", "Ambyu-Lance", "Tracks the state of the Ambyu-Lance encounter where Susie demonstrates UltimateHeal.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[571] = ["spamton_neo_encounter_outcome", "Spamton NEO", "Tracks how the Spamton NEO fight ended. The SnowGrave route sets this to Spared, the same value as a peaceful win, because the fight does not end by depleting his HP. A value of Violenced also makes the Spamton chest give the PuppetScarf weapon instead of the DealMaker armor.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
    f[572] = ["vase_poppup_encounter_outcome", "Poppup", "Tracks the state of the Poppup under the vase near where Susie and Ralsei leave you.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
