    f[542] = ["tasque_manager_encounter_outcome", "Tasque Manager", "Tracks the state of the Tasque Manager battle.", "0=Default state, 1=Violenced, 2=Spared (includes SnowGrave), 3=Pacified, 4=In combat (Ch. 1), 5=Violenced by uncontrolled Susie (unused in demo due to a bug), 6=Frozen", 1];
