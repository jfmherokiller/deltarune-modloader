    f[910] = ["egg_room_progress_ch1", "Starwalker Room: Room progress", "Your progress to finding... him.", "0=Default state, 1=Entered room, 2=Interacted with man", 1];
    f[911] = ["obtained_egg_ch1", "Starwalker Room: Got the egg", "Set when entering Chapter 2 if you had or deposited the Chapter 1 egg, but not if you dropped it. Maybe. It checks the key item.", "0/1", 0];
    f[912] = ["language_name", "Language", "Language your name was entered in, used to display the correct font even if you change the game language later.", "0=English, 1=Japanese", 1];
    f[913] = ["interacted_with_man_car", "Town South: Saw man in car", "Whether you saw the man wave at you from his car, if flag 910 up there was 2 (even if you refused the offer).", "0/1", 1];
    f[914] = ["starting_chapter", "Starting chapter", "The chapter you started your current save file on, is 0 if the file was created on the current chapter.", "", 1];
    f[915] = ["snowgrave_route_progress", "Weird Route: Progress", "Your progress on the Snowgrave Route. This is a big one.", "0=Default state, 1=Froze tutor Virovirokun, 1.5=Froze Trash Zone enemies, 1.75=Froze roadway enemies, 2=Ready for Freeze Ring, 3=Got Freeze Ring, 4=Passed forcefield, 5=Froze mouse puzzle, 6=SnowGrave., 7=Entered mansion, 8=Rouxls's condition explained, 9=Did not see Suselle scene, 19=Seen Noelle with Rudy, 20=Creeped Noelle out", 1];
    f[916] = ["snowgrave_fail", "Weird Route: Failed", "Whether you failed the Snowgrave Route at any point, by any action. Reverts practically every effect of the route.", "0/1", 1];
    f[917] = ["egg_room_progress_ch2", "Egg Room: Room progress", "Your progress to finding him. Again.", "0=Default state, 1=Killed by dog, 2=Entered egg room, 3=Interacted with man", 1];
    f[918] = ["obtained_egg_ch2", "Egg Room: Got the egg", "Whether you got the Chapter 2 egg, for Temmie's collection.", "0/1", 1];
    f[919] = ["noelle_level_up_count", "Times Noelle Leveled", "Like flag 65 but for Noelle in particular. Unaccessed. (unused)", "", 1];
    f[920] = ["obtained_moss_ch2", "Got the moss", "Whether you got the Moss in Chapter 2 and the Moss Finder title.", "0/1", 1];
    f[921] = ["ate_moss_with_noelle", "Ate moss with Noelle", "Whether Noelle was with you when you found the Moss, earning the Moss Neutral title.", "0/1", 1];
    f[922] = ["ate_moss_with_susie", "Ate moss with Susie", "Whether Susie was with you when you found the Moss, earning the Moss Enjoyer title.", "0/1", 1];
    f[923] = ["failed_snowgrave_without_thorn_ring", "Weird Route: Forgot Ring", "Whether you failed the Snowgrave route because of not having the Thorn Ring at Berdly. Unaccessed.", "0/1", 1];
    f[924] = ["snowgrave_kill_command_count", "Snowgrave Attempts", "The number of times you told Noelle to KILL HIM, KILL HIM NOW. (0-4)", "", 1];
    f[925] = ["iceshocks", "Weird Route: IceShock uses", "The number of IceShocks Noelle has used, finishing or not. Each increases her Coldness by 7.", "", 1];
