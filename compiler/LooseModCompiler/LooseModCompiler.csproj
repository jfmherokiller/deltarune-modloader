<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Standalone loose-mod compiler: modloader/tools/ImportLooseMod.csx compiled as a program against
    UndertaleModLib + Underanalyzer (external/UndertaleModTool submodule, pinned to 0.9.2.0) instead
    of being run as a script by UndertaleModCli. Same input (DR_MOD_DIRS), same output (DR_OUT_PIPE),
    same command line as UndertaleModCli, so the loader can start either.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TieredPGO>true</TieredPGO>
    <!-- script-style code: unused locals, obsolete APIs etc. are not this project's business -->
    <NoWarn>$(NoWarn);CS0168;CS0219;CS0618;CS8321;CS1998</NoWarn>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <!-- Release build (dotnet publish -r win-x64): self-contained, framework trimmed. TrimMode=partial
       trims only trim-safe framework assemblies; UndertaleModLib/Underanalyzer/Magick stay whole
       (reflection). Set here, not on the command line, so it doesn't reach netstandard2.1 projects. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <!-- trimmed framework assemblies lose their precompiled code; R2R restores it (Wine: 3.3 s -> 2.4 s) -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <TrimMode>partial</TrimMode>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <DebugType>none</DebugType>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- RuntimeExports.cs is called from native hosts (RunnerCompiler YYToolkit plugin); trimming
         switches this off in runtimeconfig.json otherwise (hostfxr 0x800080a7). -->
    <_EnableConsumingManagedCodeFromNativeHosting>true</_EnableConsumingManagedCodeFromNativeHosting>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../modloader/tools/ImportLooseMod.csx" Link="ImportLooseMod.cs" />
    <!-- GML -> .gmlo object compiler, shared with the GmlObjectCompiler CLI (RuntimeExports.CompileObject) -->
    <Compile Include="../GmlObjectCompiler/GmlObject.cs" Link="GmlObject.cs" />
    <ProjectReference Include="../../external/UndertaleModTool/UndertaleModLib/UndertaleModLib.csproj" />
  </ItemGroup>
</Project>
